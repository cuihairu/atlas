{
  "title": "Atlas",
  "uid": "atlas-overview",
  "tags": ["atlas"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Servers Online",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(atlas_registry_servers_total{status=\"online\"})",
          "legendFormat": "online",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 1 }, { "color": "green", "value": 5 } ] } },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Characters Indexed",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 0 },
      "targets": [
        {
          "expr": "atlas_directory_characters_total",
          "legendFormat": "characters",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Servers by Status",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 },
      "targets": [
        {
          "expr": "atlas_registry_servers_total",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "fillOpacity": 10 } },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Heartbeat Lag (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(atlas_registry_heartbeat_lag_seconds_bucket[$m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "sum(rate(atlas_registry_heartbeat_lag_seconds_sum[$m])) / sum(rate(atlas_registry_heartbeat_lag_seconds_count[$m]))",
          "legendFormat": "avg",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "Discovery QPS by Filter",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum(rate(atlas_discovery_requests_total[$m])) by (filter)",
          "legendFormat": "{{filter}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Admin API QPS",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 6 },
      "targets": [
        {
          "expr": "sum(rate(atlas_admin_requests_total[$m])) by (endpoint, status)",
          "legendFormat": "{{endpoint}} {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Health Transitions",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 6 },
      "targets": [
        {
          "expr": "sum(rate(atlas_health_transitions_total[$m])) by (from, to)",
          "legendFormat": "{{from}}→{{to}}",
          "refId": "A"
        }
      ]
    }
  ]
}
