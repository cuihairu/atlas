# Atlas v0.1.0 configuration
# Copy to .env and adjust as needed.

# HTTP listen address
ATLAS_HTTP_ADDR=:8080

# Storage backend: "memory" (default) or "postgres"
ATLAS_STORE=memory

# PostgreSQL connection URL (required when ATLAS_STORE=postgres)
ATLAS_DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas?sslmode=disable

# Redis connection URL (required when ATLAS_STORE=postgres)
ATLAS_REDIS_URL=redis://localhost:6379/0

# Health check timing
ATLAS_SUSPECT_AFTER=30s
ATLAS_OFFLINE_AFTER=60s
ATLAS_HEALTH_INTERVAL=10s