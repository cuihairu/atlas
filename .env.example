# Atlas quick-start environment variables
# Copy to .env (`cp .env.example .env`) and adjust as needed; docker compose
# reads the .env in the same directory automatically.
# .env is excluded by .gitignore and never committed (keep secrets here only).

# How to pick a tag for the Atlas image (ghcr.io/cuihairu/atlas):
#   latest        —— newest build of the main branch, rolling (default)
#   main          —— same as latest
#   <short SHA> (e.g. e3f802d) —— pinned to a commit for controlled upgrades (recommended for production)
#   YYYYMMDD      —— pinned by date
#   local image tag  —— a locally docker-built image, e.g. atlas:dev
ATLAS_IMAGE=ghcr.io/cuihairu/atlas:latest

# PostgreSQL password (secret value; defaults to atlas locally — use a strong password in production)
ATLAS_PG_PASSWORD=atlas
