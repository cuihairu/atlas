# Leave empty by default = same-origin relative paths, split by vite's dev/preview proxy:
#   /v1/admin → http://localhost:8082 (admin API, no CORS)
#   /v1       → http://localhost:8080 (public Discovery/Directory/Routing)
# Override only when connecting directly (browsers require CORS on the target):
# VITE_API_BASE=http://localhost:8080
# VITE_ADMIN_API_BASE=http://localhost:8082
