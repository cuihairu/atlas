<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Atlas</RootNamespace>

    <!-- NuGet package config (TODO v0.1.11) -->
    <PackageId>Atlas.Client</PackageId>
    <Version>0.1.11</Version>
    <Authors>cuihairu</Authors>
    <Description>Atlas game-server registry / discovery / directory / routing client for .NET (HttpClient + System.Text.Json).</Description>
    <PackageTags>atlas;game-server;registry;discovery;grpc-gateway;dotnet</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/cuihairu/atlas</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild Condition="'$(Configuration)' == 'Release'">true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" Link="README.md" />
  </ItemGroup>

</Project>
